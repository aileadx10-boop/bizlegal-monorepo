# Normalize line endings to LF in the repo to stop cross-OS CRLF churn.
# Without this, a Windows checkout shows ~1000 files as modified (CRLF vs LF),
# which risks an accidental whole-repo line-ending commit.
* text=auto eol=lf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp4 binary
*.zip binary

# Windows scripts must keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
