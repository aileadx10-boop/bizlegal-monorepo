[Unit]
Description=CoGuard Court Binder Generator (port 8083)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/bizlegal/curator
EnvironmentFile=/opt/bizlegal/curator/.env
ExecStart=/opt/bizlegal/curator/.venv/bin/python /opt/bizlegal/curator/coguard_binder.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
