{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizlegal-ai.com/schemas/jurisdiction-snapshot.json",
  "title": "JurisdictionSnapshot",
  "description": "BizLegal-AI free Jurisdiction Risk Snapshot (lead magnet). Compares 2 jurisdictions across 6 dimensions for a specific activity.",
  "type": "object",
  "required": ["snapshot_id", "requested_at", "request", "jurisdictions", "pipeline_meta"],
  "additionalProperties": false,
  "properties": {
    "snapshot_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "requested_at": { "type": "string", "format": "date-time" },
    "request": {
      "type": "object",
      "required": ["full_name", "email", "jurisdiction_codes", "activity"],
      "properties": {
        "full_name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "format": "email" },
        "company": { "type": ["string", "null"] },
        "jurisdiction_codes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "description": "ISO 3166-1 alpha-2 or well-known jurisdiction shortcodes (UAE, EU, US, UK, SG, CH, CA, HK, BVI, KY, etc.)",
          "items": { "type": "string", "minLength": 2, "maxLength": 10 }
        },
        "activity": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500,
          "description": "The user's planned or current regulated activity (e.g., 'stablecoin issuance', 'VASP custody', 'DAO treasury management')"
        },
        "urgency_window": {
          "type": ["string", "null"],
          "enum": ["within_30_days", "within_90_days", "within_6_months", "exploratory", null]
        }
      }
    },
    "jurisdictions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["code", "display_name", "posture", "licensing", "tax_summary", "banking_accessibility", "recent_enforcement", "upcoming_deadlines"],
        "properties": {
          "code": { "type": "string" },
          "display_name": { "type": "string" },
          "posture": {
            "type": "object",
            "properties": {
              "label": { "type": "string", "enum": ["supportive", "neutral", "hostile", "mixed"] },
              "rationale": { "type": "string" }
            }
          },
          "licensing": {
            "type": "object",
            "properties": {
              "required_licenses": { "type": "array", "items": { "type": "string" } },
              "typical_timeline": { "type": "string" },
              "typical_cost_usd": { "type": "string", "description": "Range or estimate, e.g., '$15k-$35k'" },
              "regulator": { "type": "string" }
            }
          },
          "tax_summary": {
            "type": "object",
            "properties": {
              "corporate_rate": { "type": "string" },
              "vat_gst": { "type": "string" },
              "crypto_specific_treatment": { "type": "string" }
            }
          },
          "banking_accessibility": {
            "type": "object",
            "properties": {
              "rating": { "type": "string", "enum": ["excellent", "good", "moderate", "challenging", "restricted"] },
              "notes": { "type": "string" }
            }
          },
          "recent_enforcement": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["date", "actor", "summary"],
              "properties": {
                "date": { "type": "string", "description": "Approximate date or quarter, e.g., '2026-Q1'" },
                "actor": { "type": "string", "description": "Regulator or court name" },
                "summary": { "type": "string" },
                "penalty": { "type": ["string", "null"] },
                "source_url": { "type": ["string", "null"], "format": "uri" }
              }
            }
          },
          "upcoming_deadlines": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["date", "requirement"],
              "properties": {
                "date": { "type": "string" },
                "requirement": { "type": "string" },
                "source_url": { "type": ["string", "null"], "format": "uri" }
              }
            }
          }
        }
      }
    },
    "side_by_side": {
      "type": "object",
      "description": "At-a-glance comparison block for the final bullet summary.",
      "properties": {
        "verdict": {
          "type": "string",
          "description": "One-sentence take on which jurisdiction fits the activity better."
        },
        "winner_code": { "type": ["string", "null"] },
        "key_tradeoffs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "citations": {
      "type": "array",
      "description": "Authoritative sources used in the snapshot",
      "items": {
        "type": "object",
        "required": ["label", "url"],
        "properties": {
          "label": { "type": "string" },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "critique": {
      "type": ["object", "null"],
      "description": "Populated by Haiku critique pass",
      "properties": {
        "factual_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "hallucination_risks": { "type": "array", "items": { "type": "string" } },
        "missing_data_flags": { "type": "array", "items": { "type": "string" } },
        "escalate_to_sonnet": { "type": "boolean", "default": false }
      }
    },
    "pipeline_meta": {
      "type": "object",
      "required": ["draft_model", "status"],
      "properties": {
        "draft_model": { "type": "string" },
        "critique_model": { "type": ["string", "null"] },
        "retries": { "type": "integer", "minimum": 0, "default": 0 },
        "status": {
          "type": "string",
          "enum": ["received", "drafted", "critiqued", "stored", "delivered", "failed", "dlq"]
        },
        "error_class": { "type": ["string", "null"] },
        "error_detail": { "type": ["string", "null"] },
        "processed_at": { "type": ["string", "null"], "format": "date-time" },
        "duration_ms": { "type": ["integer", "null"] }
      }
    }
  }
}
