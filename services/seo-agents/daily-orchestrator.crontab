# BizLegal AI — daily_orchestrator.py crontab
# Install: crontab /opt/bizlegal/curator/daily-orchestrator.crontab
# View:    crontab -l
# Logs:    /var/log/daily-orchestrator.log
#
# All times UTC. Adjust if your local TZ is different (Moses IDT = UTC+3,
# so the 19:00 UTC report arrives at 22:00 IDT = after dinner).
#
# Prerequisites:
#   - Hetzner /opt/bizlegal/curator/.env has SUPABASE_SECRET, NOWPAYMENTS_API_KEY,
#     ANTHROPIC_API_KEY, NEW_OPENAI_KEY, PERPLEXITY_API_KEY, RESEND_API_KEY,
#     TELEGRAM_CURATOR_BOT_TOKEN, TELEGRAM_CHAT_ID
#   - python3 deps: pip install requests (or use stdlib only - this script uses urllib)
#   - Cron daemon running: systemctl status cron
#
# 00:00 - brain.py (existing, on systemd) drafts 1-3 articles
# 04:00 - Content Enricher (Agent A): 30 articles get TL;DR + tables + cross-links
# 05:00 - Visual Assets (Agent B): 30 hero PNGs via OpenAI gpt-image-1
# 06:00 - Affiliate Funnel (Agent C): 30 articles get product CTAs
# 07:00 - GEO Citation (Agent D): Perplexity polling for citations
# 08:00 - Site Health Crawler: all 8 subdomains, 4 paths each
# 13:00 - SEO Watchdog: consolidate morning crawlers, fire IndexNow
# 14:00 - Brain v2: short articles on GSC "impressions no clicks" (placeholder)
# 15:00 - Sales Attribution: NOWPayments + Stripe + PayPal pulls
# 16:00 - Leads Pipeline: Supabase inbound_leads last 24h
# 17:00 - Customer Quality: Supabase user activity (placeholder)
# 19:00 - Consolidated Daily Report: writes DAILY-REPORT-*.md, sends Telegram summary
# 20:00 - Newsletter send: top 3 articles + 1 product CTA to subscriber list
# 21:00 - Backup + cleanup: archive yesterday's reports, prune logs

# Editable wrapper: cd into the project and source .env first
DIR=/opt/bizlegal/curator
PYTHON=python3
SCRIPT=$DIR/services/seo-agents/daily_orchestrator.py

# 04:00 - Content Enricher
0 4 * * *  cd $DIR && set -a && . ./.env && set +a && $PYTHON $SCRIPT --task=04 >> /var/log/daily-orchestrator.log 2>&1

# 05:00 - Visual Assets
0 5 * * *  cd $DIR && set -a && . ./.env && set +a && $PYTHON $SCRIPT --task=05 >> /var/log/daily-orchestrator.log 2>&1

# 06:00 - Affiliate Funnel
0 6 * * *  cd $DIR && set -a && . ./.env && set +a && $PYTHON $SCRIPT --task=06 >> /var/log/daily-orchestrator.log 2>&1

# 07:00 - GEO Citation (Perplexity)
0 7 * * *  cd $DIR && set -a && . ./.env && set +a && $PYTHON $SCRIPT --task=07 >> /var/log/daily-orchestrator.log 2>&1

# 08:00 - Site Health Crawler
0 8 * * *  cd $DIR && set -a && . ./.env && set +a && $PYTHON $SCRIPT --task=08 >> /var/log/daily-orchestrator.log 2>&1

# 13:00 - SEO Watchdog (consolidate morning crawlers)
0 13 * * * cd $DIR && set -a && . ./.env && set +a && $PYTHON $SCRIPT --task=13 >> /var/log/daily-orchestrator.log 2>&1

# 15:00 - Sales Attribution (NOWPayments + PayPal - both live)
0 15 * * * cd $DIR && set -a && . ./.env && set +a && $PYTHON $SCRIPT --task=15 >> /var/log/daily-orchestrator.log 2>&1

# 16:00 - Leads Pipeline (Supabase inbound_leads)
0 16 * * * cd $DIR && set -a && . ./.env && set +a && $PYTHON $SCRIPT --task=16 >> /var/log/daily-orchestrator.log 2>&1

# 19:00 - Consolidated Daily Report (THE MAIN EVENT)
0 19 * * * cd $DIR && set -a && . ./.env && set +a && $PYTHON $SCRIPT --task=19 >> /var/log/daily-orchestrator.log 2>&1

# Hourly heartbeat (just logs liveness)
0 * * * *  cd $DIR && set -a && . ./.env && set +a && $PYTHON -c "from datetime import datetime, timezone; print(datetime.now(timezone.utc).isoformat(), 'heartbeat')" >> /var/log/daily-orchestrator.log 2>&1
