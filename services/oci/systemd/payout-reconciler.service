[Unit]
Description=Fire referral.paid ops events for newly-paid payouts (idempotent via Redis dedupe)
After=deal-router.service
Wants=deal-router.service

[Service]
Type=oneshot
WorkingDirectory=/opt/oci-deal-router
EnvironmentFile=/opt/oci-deal-router/.env
ExecStart=/usr/bin/docker exec deal-router python /app/payout_reconciler.py
TimeoutStartSec=120
