{
  "name": "legal-gap-scout",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * 1,3,5"
            }
          ]
        }
      },
      "id": "1",
      "name": "Cron — Mon/Wed/Fri 06:00 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300],
      "notes": "Backup: curator-scout.timer fires the same scout via systemd if n8n is down"
    },
    {
      "parameters": {
        "command": "/opt/bizlegal/venv/bin/python /opt/bizlegal/curator/scout.py"
      },
      "id": "2",
      "name": "Run scout.py",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [520, 300],
      "notes": "scout.py is idempotent — re-running picks the next batch. Dedupes on URL via Supabase upsert."
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json[\"exitCode\"] }}",
              "operation": "equal",
              "value2": "0"
            }
          ]
        }
      },
      "id": "3",
      "name": "Did it succeed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [780, 300]
    },
    {
      "parameters": {
        "url": "https://api.telegram.org/bot{{$env.TELEGRAM_CURATOR_BOT_TOKEN}}/sendMessage",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": \"{{$env.TELEGRAM_CHAT_ID}}\",\n  \"text\": \"⚠️ Scout failed — exit ${{$json.exitCode}}. Check journalctl -u curator-scout.service or n8n exec log.\"\n}"
      },
      "id": "4",
      "name": "Alert on failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1040, 420]
    }
  ],
  "connections": {
    "Cron — Mon/Wed/Fri 06:00 UTC": {
      "main": [[{ "node": "Run scout.py", "type": "main", "index": 0 }]]
    },
    "Run scout.py": {
      "main": [[{ "node": "Did it succeed?", "type": "main", "index": 0 }]]
    },
    "Did it succeed?": {
      "main": [
        [],
        [{ "node": "Alert on failure", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "UTC",
    "saveExecutionProgress": true,
    "saveManualExecutions": true,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  },
  "tags": ["bizlegal-ai", "curator", "scout"],
  "active": false
}
