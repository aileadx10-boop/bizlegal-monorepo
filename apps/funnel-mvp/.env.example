# apps/funnel-mvp — Next.js + Supabase + PayPal
# All values in canonical vault. Pre-commit hook blocks new env refs.

# --- Supabase (replaces Firebase) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=funnel-uploads

# --- AI extraction (Claude Haiku 4.5 primary, Minimax fallback) ---
ANTHROPIC_API_KEY=
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.chat/v1
MINIMAX_MODEL=MiniMax-M2

# --- PayPal (replaces LemonSqueezy) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# --- BizLegal monorepo wiring ---
BIZLEGAL_INBOUND_SECRET=
NEXT_PUBLIC_APP_URL=https://funnel.bizlegal-ai.com

# --- Analytics (Phase RR R5) ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=bizlegal-ai.com
