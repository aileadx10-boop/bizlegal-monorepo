{
  "compilerOptions": {
    "outDir": "../.test-out",
    "rootDir": "..",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2022",
    "lib": ["es2022"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "noEmit": false,
    "baseUrl": "..",
    "paths": { "@/*": ["./*"] }
  },
  "include": ["pure.test.ts"]
}
