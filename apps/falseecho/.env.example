# Fleet ops
OPS_LOG_URL=https://bizlegal-ai.com/api/ops/log
BIZLEGAL_INBOUND_SECRET=
OPS_DASHBOARD_TOKEN=

# Marketing content queue (goal M.3) — absent URL = emission silently skipped
