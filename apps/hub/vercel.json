{
  "framework": "nextjs",
  "installCommand": "corepack enable && corepack pnpm install --frozen-lockfile=false --ignore-scripts",
  "buildCommand": "cd ../.. && corepack pnpm turbo build --filter=@bizlegal/hub...",
  "functions": {
    "app/api/risk-assessment/route.ts": { "maxDuration": 30 },
    "app/api/risk-engine/deep-analysis/route.ts": { "maxDuration": 60 },
    "app/api/jurisdictions/compare/route.ts": { "maxDuration": 60 },
    "app/api/og/route.tsx": { "maxDuration": 10 },
    "app/api/tracr/analyze/route.ts": { "maxDuration": 30 },
    "app/api/tracr/generate-report/route.ts": { "maxDuration": 60 },
    "app/api/tracr/verify-eth/route.ts": { "maxDuration": 60 },
    "app/api/tracr/webhook/route.ts": { "maxDuration": 60 },
    "app/api/tracr/create-order/route.ts": { "maxDuration": 15 },
    "app/api/tracr/paypal-order/route.ts": { "maxDuration": 15 },
    "app/api/tracr/paypal-capture/route.ts": { "maxDuration": 60 },
    "app/api/payments/nowpayments/start/route.ts": { "maxDuration": 30 },
    "app/api/payments/nowpayments/webhook/route.ts": { "maxDuration": 30 },
    "app/api/payments/paypal/start/route.ts": { "maxDuration": 30 },
    "app/api/payments/paypal/webhook/route.ts": { "maxDuration": 30 },
    "app/api/cron/billing/charge-due/route.ts": { "maxDuration": 60 },
    "app/api/cron/boi/check/route.ts": { "maxDuration": 60 },
    "app/api/cron/ops-alerts/route.ts": { "maxDuration": 30 },
    "app/api/cron/smoke/route.ts": { "maxDuration": 60 },
    "app/api/cron/ai-act-monitor/route.ts": { "maxDuration": 60 },
    "app/api/ai-act/classify/route.ts": { "maxDuration": 60 },
    "app/api/cron/policy-refresh/route.ts": { "maxDuration": 60 },
    "app/api/policy-refresh/audit/route.ts": { "maxDuration": 60 },
    "app/api/ops/health/route.ts": { "maxDuration": 30 },
    "app/api/boi/subscribe/route.ts": { "maxDuration": 30 },
    "app/api/agents/run/route.ts": { "maxDuration": 60 },
    "app/api/agents/enrich-pages/route.ts": { "maxDuration": 300 },
    "app/api/cron/affiliate-reconcile/route.ts": { "maxDuration": 30 },
    "app/api/cron/social-queue/route.ts": { "maxDuration": 60 },
    "app/api/cron/daily-todo/route.ts": { "maxDuration": 60 },
    "app/api/content/syndicate/route.ts": { "maxDuration": 60 },
    "app/api/cron/invoices/route.ts": { "maxDuration": 60 },
    "app/api/newsletter/send/route.ts": { "maxDuration": 60 },
    "app/api/cron/guide-social/route.ts": { "maxDuration": 90 },
    "app/api/cron/mica-deadlines/route.ts": { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/cron/billing/charge-due",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/boi/check",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/ops-alerts",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/smoke",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/ai-act-monitor",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/policy-refresh",
      "schedule": "0 12 * * *"
    },
    { "path": "/api/agents/run?task=daily-revenue-digest",            "schedule": "0 8 * * *" },
    { "path": "/api/agents/run?task=daily-vertical-classifier-audit", "schedule": "30 8 * * *" },
    { "path": "/api/agents/run?task=daily-content-pick-suggestion",   "schedule": "30 9 * * *" },
    { "path": "/api/agents/run?task=daily-affiliate-followup",        "schedule": "0 10 * * *" },
    { "path": "/api/agents/run?task=weekly-mrr-review",               "schedule": "0 9 * * 1" },
    { "path": "/api/agents/run?task=friday-retrospective",            "schedule": "0 17 * * 5" },
    { "path": "/api/agents/run?task=monthly-vertical-scorecard",      "schedule": "0 9 1 * *" },
    { "path": "/api/cron/affiliate-reconcile",                        "schedule": "30 10 * * 5" },
    { "path": "/api/cron/social-queue",                               "schedule": "*/30 * * * *" },
    { "path": "/api/cron/daily-todo",                                 "schedule": "0 6 * * *" },
    { "path": "/api/cron/invoices",                                   "schedule": "0 10 * * *" },
    { "path": "/api/agents/enrich-pages",                              "schedule": "0 4 * * 0" },
    { "path": "/api/newsletter/send",                                  "schedule": "0 13 * * 1" },
    { "path": "/api/cron/guide-social",                                "schedule": "30 5 * * *" },
    { "path": "/api/cron/mica-deadlines",                              "schedule": "17 15 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
