# ─────────────────────────────────────────────────────────────
# BizLegal AI — canonical fleet env template (P4.a)
#
# Source of truth for every repo's .env.example. Per-repo
# .env.example files are regenerated from this template by
# sync-env.sh using the per-repo tier selection in manifest.json.
#
# Tier markers below are parsed by sync-env.sh. Do not rename.
# Adding a variable:
#   1. Place it under the right tier (section header).
#   2. Update manifest.json if a new repo consumes it.
#   3. Run sync-env.sh.
#   4. Commit the canonical template + manifest + every
#      regenerated per-repo .env.example together.
# ─────────────────────────────────────────────────────────────

# ── TIER 0: FLEET-WIDE (every repo) ──
NODE_ENV=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_DISCLAIMER_VERSION=v1.0.0-p4
NEXT_PUBLIC_HUB_URL=https://bizlegal-ai.com
RESEND_API_KEY=
SENTRY_DSN=

# ── TIER 1: AUTH + DATA (every repo) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── TIER 2: AI / LLM (hub, lexaudit, docai, leadforge, safe) ──
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=

# ── TIER 3: CHAIN INTELLIGENCE (trcr, BRAI) ──
GOLDRUSH_API_KEY=
ALCHEMY_API_KEY=
COVALENT_API_KEY=
ETHERSCAN_API_KEY=
OFAC_LIST_URL=https://www.treasury.gov/ofac/downloads/sdn.xml
UN_SANCTIONS_URL=https://scsanctions.un.org/resources/xml/en/consolidated.xml
EU_SANCTIONS_URL=https://webgate.ec.europa.eu/fsd/fsf/public/files/xmlFullSanctionsList_1_1/content
TRACR_ETH_ADDRESS=
TRACR_WEBHOOK_SECRET=

# ── TIER 4: INTENT SIGNALS (leadforge) ──
SEC_EDGAR_USER_AGENT=
DOJ_PRESS_WIRE_KEY=
JOB_SIGNALS_API_KEY=

# ── TIER 5: BILLING (every revenue-bearing repo) ──
# Legacy processors (pre-pivot) kept alongside P6's Stripe setup.
# Hard constraint: no payment-processor changes on existing repos.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Stripe is P6 LexAudit Safe only at present.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── TIER 6: LEXAUDIT SAFE (safe only, used in P6) ──
SAFE_REDACTION_MODEL_PATH=
SAFE_AUDIT_LOG_BUCKET=
SAFE_KMS_KEY_ID=
SAFE_PRESIDIO_ENDPOINT=

# ── TIER 7: OPERATIONS (cron endpoints) ──
CRON_SECRET=
