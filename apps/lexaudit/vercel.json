{
  "name": "lexaudit",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "devCommand": "next dev",
  "installCommand": "corepack enable && cd ../.. && corepack pnpm install --frozen-lockfile=false --ignore-scripts",
  "buildCommand": "cd ../.. && corepack pnpm turbo build --filter=@bizlegal/lexaudit...",
  "functions": {
    "app/api/cron/monitor/diff/route.ts": { "maxDuration": 60 },
    "app/api/monitor/check/route.ts": { "maxDuration": 30 }
  },
  "crons": [
    {
      "path": "/api/cron/monitor/diff",
      "schedule": "0 6 * * *"
    }
  ]
}
