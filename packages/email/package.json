{
  "name": "@bizlegal/email",
  "version": "0.1.0",
  "private": true,
  "description": "The single outbound email path. Suppression + double-opt-in enforced inside the package, not by callers. Raw fetch only, so it runs on Node, Next and Cloudflare Workers.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": ["src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo ok",
    "test": "echo 'no tests yet'"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "typescript": "^5.7.2"
  }
}
