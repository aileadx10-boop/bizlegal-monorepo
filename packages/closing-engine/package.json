{
  "name": "@bizlegal/closing-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic closing-deadline engine: pluggable working-week calendar, task templates, alert tiers. Pure \u2014 no LLM, no network, no ambient clock.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.js",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./us/date-calculator": {
      "types": "./src/us/date-calculator.ts",
      "import": "./src/us/date-calculator.ts",
      "default": "./src/us/date-calculator.ts"
    },
    "./us/checklist-templates": {
      "types": "./src/us/checklist-templates.ts",
      "import": "./src/us/checklist-templates.ts",
      "default": "./src/us/checklist-templates.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo ok",
    "test": "node tests/run.cjs"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "typescript": "^5.7.2"
  }
}
