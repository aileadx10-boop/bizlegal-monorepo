{
  "name": "@bizlegal/payment",
  "version": "0.1.0",
  "private": true,
  "description": "Code-only payment gateway clients (NOWPayments + PayPal + LemonSqueezy + Paddle stubs). Replaces NEXT_PUBLIC_*_URL env constants with on-the-fly checkout-URL generation.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./products": {
      "types": "./src/products.ts",
      "import": "./src/products.ts",
      "default": "./src/products.ts"
    }
  },
  "files": ["src", "dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo ok",
    "test": "echo 'no tests yet'"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "typescript": "^5.7.2"
  }
}
