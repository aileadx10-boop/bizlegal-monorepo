{
  "name": "@bizlegal/themes",
  "version": "0.1.0",
  "private": true,
  "description": "Single source of truth for the 4 BizLegal-AI subdomain themes (twilight, daybreak, royal-dark, royal-light) plus React provider, FOUC-prevention inline script, and the shared StickyLeadBadge component. Phase AA Subdomain Design Pass.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": ["src", "dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo ok",
    "test": "echo 'no tests yet'",
    "validate-themes": "node --experimental-strip-types src/themes.validate.ts"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "next": "^14.0.0 || ^15.0.0",
    "@bizlegal/turnstile-widget": "workspace:*"
  },
  "devDependencies": {
    "@bizlegal/turnstile-widget": "workspace:*",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.0",
    "typescript": "^5.7.2"
  }
}
